# ==============================================================================
# DB Schema Comparison & Version Control System - Environment Configuration
# Copy this file to .env.local and fill in your values.
# ==============================================================================

# PostgreSQL Docker Environments (matches docker-compose.yml)
DEV_DATABASE_URL=postgresql://root:password@127.0.0.1:5432/dev_schema
STAGING_DATABASE_URL=postgresql://root:password@127.0.0.1:5433/staging_schema
PROD_DATABASE_URL=postgresql://root:password@127.0.0.1:5434/prod_schema

# Internal System Control Plane Database (stores users, encrypted connections, migrations)
DATABASE_URL=postgresql://root:password@127.0.0.1:5432/dev_schema

# AES-256-GCM Encryption Secret for stored connection URIs (use a strong 32+ char secret)
ENCRYPTION_SECRET=change-this-to-a-strong-32-character-secret-key

# NextAuth & Microsoft Entra ID (Azure AD) Authentication (SRS FR1)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Set to "true" to enforce Entra ID sign-in on all API routes and dashboard views.
# Keep "false" for local offline/academic development without Azure AD credentials.
AUTH_REQUIRED=false

# GitHub REST API Integration for Automated Migration Commits (SRS FR10)
GITHUB_TOKEN=
GITHUB_OWNER=raph-ez
GITHUB_REPO=db-schema-version-control
GITHUB_BRANCH=main
GITHUB_MIGRATIONS_PATH=migrations
